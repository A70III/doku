{
  "name": "doku",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/fs-node/tsconfig.json && tsc --noEmit -p packages/cli/tsconfig.json && tsc --noEmit -p packages/server/tsconfig.json",
    "gen:schema": "bun run scripts/gen-schema.ts",
    "doku": "bun run packages/cli/src/index.ts",
    "dev": "bash scripts/dev.sh",
    "build:css": "bunx @tailwindcss/cli -i packages/server/src/web/styles/app.css -o packages/server/public/app.css --minify",
    "gen:icons": "bun run scripts/gen-icons.ts",
    "build:editor": "bun run scripts/build-editor.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@doku/core": "workspace:*",
    "@tailwindcss/cli": "^4.0.0",
    "@types/bun": "^1.2.0",
    "lucide-static": "^1.45.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "zod": "^4.0.0"
  }
}
