# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# generated from Zod (see docs/04-tech-stack.md)
schema/

# generated CSS (bun run build:css / scripts/dev.sh)
packages/server/public/

# runtime / disposable data
var/
*.log

# personal vault content — do not commit
